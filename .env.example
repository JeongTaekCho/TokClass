# ── Supabase ─────────────────────────────────────────────
# 프로젝트 URL (Project Settings → API / Data API)
NEXT_PUBLIC_SUPABASE_URL=
# 공개 키: anon(레거시) 또는 publishable 키 (브라우저에 노출돼도 되는 키)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 키: service_role(레거시) 또는 secret 키. 절대 NEXT_PUBLIC_ 으로 시작하면 안 돼요.
SUPABASE_SERVICE_ROLE_KEY=
# 수강생 Realtime 토큰 서명용 JWT Secret (Project Settings → JWT Keys → Legacy JWT Secret)
SUPABASE_JWT_SECRET=

# ── 톡클 서버 비밀값 (각각 32자 이상 무작위 문자열) ─────────
# 수강생 임시 비밀번호 HMAC 키. 운영 중에 바꾸면 기존 비밀번호가 모두 무효가 돼요.
PARTICIPANT_PASSWORD_SECRET=
# 수강생 세션 쿠키 서명 키
SESSION_SECRET=

# ── 사이트 주소 (선택) ─────────────────────────────────────
# 비우면 Vercel 배포 주소를 써요. 커스텀 도메인이 있으면 넣어 주세요.
NEXT_PUBLIC_SITE_URL=

# ── AI 질문 묶기 (선택) ────────────────────────────────────
# 키가 없으면 [질문 정리하기] 버튼만 비활성화되고 나머지는 그대로 동작해요.
# anthropic(기본) | openai (OpenAI 호환 API)
AI_PROVIDER=
AI_API_KEY=
# 비우면 anthropic=claude-opus-5-5, openai=gpt-4o-mini
AI_MODEL=
# openai 호환 공급자의 base URL (선택)
AI_BASE_URL=
